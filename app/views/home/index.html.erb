<div class="w-full rounded-2xl bg-slate-100 p-10 shadow-lg">
  <h1 class="text-4xl font-bold text-blue-600">
    Rails mit Tailwindcss
  </h1>

  <p class="mt-4 text-lg text-red-600">
    Rails 7 mit dem gem tailwindcss ist erfolgreich verbunden.
  </p>

  <% if user_signed_in? %>
      <%= button_to "Benutzer abmelden",
                  destroy_user_session_path,
                  method: :delete,
                  class: "inline-flex items-center justify-center rounded-lg bg-blue-600 my-2 px-5 py-2 font-medium text-white hover:bg-blue-700 transition-colors"
      %>
  <% else %>
      <div class= "flex gap-2">
        <%= button_to "Benutzer anmelden",
                      new_user_session_path,
                      class: "inline-flex items-center justify-center rounded-lg bg-red-600 my-2 px-5 py-2 font-medium text-white hover:bg-red-700 transition-colors"
        %>

        <%= button_to "Benutzer registrieren",
                      user_registration_path,
                    class: "inline-flex items-center justify-center rounded-lg bg-red-600 my-2 px-5 py-2 font-medium text-white hover:bg-red-700 transition-colors"
        %>
      </div>
  <% end %>
  </div>


</div>